# Firebase Admin credentials for the email-updates Firestore store.
#
# Setup:
#   1. console.firebase.google.com → create (or open) the HackIndy project
#   2. Build → Firestore Database → Create database (production mode is fine —
#      the server uses the Admin SDK, which bypasses security rules)
#   3. Project settings (gear) → Service accounts → Generate new private key
#   4. From the downloaded JSON, copy the three values below
#   5. Save this file as .env.local (git-ignored) and restart `npm run dev`
#
# On Vercel: add the same three variables under Project → Settings →
# Environment Variables. Paste the private key with its \n sequences intact.
#
# Until these are set, subscriptions fall back to data/subscribers.json.

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
